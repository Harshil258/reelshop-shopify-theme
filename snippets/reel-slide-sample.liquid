{% comment %}
  ReelShop — Sample demo reel slide with working video & affiliate links
{% endcomment %}

{%- assign sym = section_settings.currency_symbol | default: '₹' -%}
{%- assign disc = original_price | minus: price | times: 100 | divided_by: original_price -%}
{%- assign current_display = sym | append: price -%}
{%- assign orig_display = sym | append: original_price -%}

<article
  class="reel-slide"
  data-handle="sample-{{ index }}"
  data-id="sample-{{ index }}"
  aria-label="{{ title | escape }}"
>
  <div class="reel-track">
    {%- if video_url != blank -%}
      <div class="reel-media">
        <video
          muted="muted"
          playsinline
          webkit-playsinline
          loop
          preload="none"
          data-src="{{ video_url | escape }}"
          {% if image_url != blank %}poster="{{ image_url | escape }}"{% endif %}
          aria-label="{{ title | escape }} video"
        ></video>
        <span class="rs-paused-badge" aria-hidden="true">
          <span><svg viewBox="0 0 24 24" focusable="false"><path d="M8 5v14l11-7z"/></svg></span>
        </span>
      </div>
    {%- endif -%}

    {%- if image_url != blank -%}
      <div class="reel-media">
        <img
          src="{{ image_url | escape }}"
          alt="{{ title | escape }}"
          {% if is_first %}fetchpriority="high" loading="eager"{% else %}loading="lazy"{% endif %}
          decoding="async"
          width="800"
          height="1200"
        >
      </div>
    {%- endif -%}
  </div>

  <div class="reel-scrim" aria-hidden="true"></div>
  <div class="reel-scrim reel-scrim--top" aria-hidden="true"></div>

  <div class="reel-info">
    <div class="reel-info__platform-wrap">
      <span class="reel-info__platform">{{ platform | capitalize }}</span>
      {%- if section_settings.show_ratings and rating != blank -%}
        <span class="reel-info__rating" aria-label="Rated {{ rating }} out of 5">★ {{ rating | plus: 0 }}</span>
      {%- endif -%}
    </div>

    <h2 class="reel-info__title">{{ title | escape }}</h2>

    {%- if desc != blank -%}
      <p class="reel-info__desc">{{ desc | escape }}</p>
    {%- endif -%}

    {%- render 'price-block', price_display: current_display, original_display: orig_display, discount_pct: disc -%}

    <a class="reel-cta" href="{{ affiliate_url | escape }}" target="_blank" rel="nofollow sponsored noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
      Buy on {{ platform | capitalize }}
    </a>
  </div>

  {%- render 'action-rail', category: category -%}

  <div class="reel-dots" aria-hidden="true"></div>

  <script type="application/json" class="reel-json">
    {
      "id": "sample-{{ index }}",
      "handle": "sample-{{ index }}",
      "title": {{ title | json }},
      "category": {{ category | json }},
      "tags": [{{ category | downcase | json }}, "demo"],
      "platform": {{ platform | json }},
      "platformLabel": {{ platform | capitalize | json }},
      "affiliateUrl": {{ affiliate_url | json }},
      "videoUrl": {{ video_url | json }},
      "images": [{% if image_url != blank %}{{ image_url | json }}{% endif %}],
      "rating": {% if rating != blank %}{{ rating | plus: 0 | json }}{% else %}null{% endif %},
      "shareUrl": "{{ shop.url }}/?reel=sample-{{ index }}"
    }
  </script>
</article>

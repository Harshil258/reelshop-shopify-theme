{% comment %}
  ReelShop — one full-screen reel slide for a single product.
  Accepts:
    - product:          the product to render
    - section_settings: the reels-feed section settings

  Metafields (namespace "reelshop") — all optional except affiliate_url,
  with graceful fallbacks to native product fields:
    reelshop.video_url         url (or video file_reference) — promo video
    reelshop.affiliate_url     url  — Amazon/Flipkart/Meesho referral link
    reelshop.platform          single_line_text — amazon | flipkart | meesho
    reelshop.price             number/money — display price
    reelshop.original_price    number/money — strikethrough price
    reelshop.currency_symbol   single_line_text — e.g. "₹"
    reelshop.category          single_line_text — used by the algorithm
    reelshop.tags_extra        list.single_line_text — used by the algorithm
    reelshop.gallery_images    list.file_reference / list.url — carousel images
    reelshop.rating            number (0–5)
{% endcomment %}

{%- liquid
  assign mf = product.metafields.reelshop

  # Affiliate link (required for monetization)
  assign affiliate_url = mf.affiliate_url

  # Platform
  assign platform = mf.platform | default: section_settings.default_platform | default: 'amazon' | downcase | strip
  case platform
    when 'amazon'
      assign platform_label = 'Amazon'
    when 'flipkart'
      assign platform_label = 'Flipkart'
    when 'meesho'
      assign platform_label = 'Meesho'
    else
      assign platform_label = platform | capitalize
  endcase
  if platform_label == blank
    assign platform_label = 'Store'
  endif

  # Price: prefer metafields, fall back to native product price
  assign symbol = mf.currency_symbol | default: section_settings.currency_symbol
  assign mf_price = mf.price
  assign mf_original = mf.original_price
  assign current_display = ''
  assign original_display = ''
  assign discount_pct = 0

  if mf_price != blank
    assign price_num = mf_price | times: 1.0
    assign price_str = price_num | append: ''
    assign price_parts = price_str | split: '.'
    assign price_clean = price_parts[0]
    if price_parts[1] != blank and price_parts[1] != '0'
      assign price_clean = price_clean | append: '.' | append: price_parts[1]
    endif
    assign current_display = symbol | append: price_clean

    if mf_original != blank
      assign orig_num = mf_original | times: 1.0
      assign orig_str = orig_num | append: ''
      assign orig_parts = orig_str | split: '.'
      assign orig_clean = orig_parts[0]
      if orig_parts[1] != blank and orig_parts[1] != '0'
        assign orig_clean = orig_clean | append: '.' | append: orig_parts[1]
      endif
      assign original_display = symbol | append: orig_clean

      if orig_num > price_num and price_num > 0
        assign discount_pct = orig_num | minus: price_num | times: 100 | divided_by: orig_num
      endif
    endif
  else
    assign current_display = product.price | money
    if product.compare_at_price > product.price
      assign original_display = product.compare_at_price | money
      assign discount_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
    endif
  endif

  # Promo video: url metafield or uploaded video file reference
  assign video_meta = mf.video_url
  assign video_url = ''
  if video_meta != blank
    if video_meta.media_type == 'video'
      assign video_url = video_meta.sources[0].url | default: ''
    else
      assign video_url = video_meta | append: ''
    endif
  endif

  # Carousel images: metafield gallery, else native product images
  assign image_urls = '' | split: ','
  assign gallery_meta = mf.gallery_images.value
  if gallery_meta != blank
    for item in gallery_meta
      if item.preview_image != blank
        assign tmp_img = item.preview_image | image_url: width: 1080
        assign image_urls = image_urls | push: tmp_img
      elsif item contains '//' or item contains 'http'
        assign image_urls = image_urls | push: item
      endif
    endfor
  endif
  if image_urls.size == 0
    for img in product.images limit: 6
      assign tmp_img = img | image_url: width: 1080
      assign image_urls = image_urls | push: tmp_img
    endfor
  endif

  # Poster frame while the video loads
  assign poster_url = image_urls[0] | default: ''
  if poster_url == blank and product.featured_image != blank
    assign poster_url = product.featured_image | image_url: width: 1080
  endif

  # Category + tags for the recommendation algorithm
  assign category = mf.category | default: product.type | default: product.tags.first | default: 'General'
  assign algo_tags = mf.tags_extra.value | default: product.tags
  if algo_tags.size > 6
    assign algo_tags = algo_tags | slice: 0, 6
  endif

  assign rating = mf.rating

  # Description (plain text) + share URL (deep link into the feed)
  assign desc_text = product.description | strip_html | truncate: 600
  assign share_url = request.origin | append: routes.root_url | append: '?product=' | append: product.handle

  assign cta_text = section_settings.cta_text | default: 'Buy on {{platform}}' | replace: '{{platform}}', platform_label
-%}

<article class="reel-slide" data-handle="{{ product.handle | escape }}" aria-label="{{ product.title | escape }}">
  <div class="reel-track">
    {%- if video_url != blank -%}
      <div class="reel-media is-loading">
        <video
          muted
          loop
          playsinline
          preload="none"
          data-src="{{ video_url | escape }}"
          {% if poster_url != blank %}poster="{{ poster_url | escape }}"{% endif %}
          aria-label="{{ product.title | escape }} promo video"
        ></video>
        <span class="rs-paused-badge" aria-hidden="true">
          <span><svg viewBox="0 0 24 24" focusable="false"><path d="M8 5v14l11-7z"/></svg></span>
        </span>
      </div>
    {%- endif -%}

    {%- for img in image_urls -%}
      <div class="reel-media is-loading">
        <img
          data-src="{{ img | escape }}"
          alt="{{ product.title | escape }} — image {{ forloop.index }}"
          decoding="async"
        >
      </div>
    {%- endfor -%}

    {%- if video_url == blank and image_urls.size == 0 -%}
      <div class="reel-media reel-media--placeholder"></div>
    {%- endif -%}
  </div>

  <div class="reel-scrim" aria-hidden="true"></div>
  <div class="reel-scrim reel-scrim--top" aria-hidden="true"></div>

  <div class="reel-info">
    <span class="reel-info__platform">{{ platform_label | escape }}</span>

    <h2 class="reel-info__title">{{ product.title | escape }}</h2>

    {%- if section_settings.show_ratings and rating != blank -%}
      <span class="reel-info__rating" aria-label="Rated {{ rating }} out of 5">★ {{ rating | plus: 0 }}</span>
    {%- endif -%}

    {%- if desc_text != blank -%}
      <p class="reel-info__desc">{{ desc_text | escape }}</p>
      {%- if desc_text.size > 120 -%}
        <button class="reel-info__more" type="button">more</button>
      {%- endif -%}
    {%- endif -%}

    {%- render 'price-block', price_display: current_display, original_display: original_display, discount_pct: discount_pct -%}

    {%- if affiliate_url != blank -%}
      <a class="reel-cta" href="{{ affiliate_url | escape }}" target="_blank" rel="nofollow sponsored noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
        {{ cta_text | escape }}
      </a>
    {%- else -%}
      <span class="reel-cta is-disabled">Set the affiliate link metafield</span>
    {%- endif -%}
  </div>

  {%- render 'action-rail', category: category -%}

  <div class="reel-dots" aria-hidden="true"></div>

  <script type="application/json" class="reel-json">
    {
      "id": {{ product.id | json }},
      "handle": {{ product.handle | json }},
      "title": {{ product.title | json }},
      "category": {{ category | json }},
      "tags": {{ algo_tags | json }},
      "platform": {{ platform | json }},
      "platformLabel": {{ platform_label | json }},
      "affiliateUrl": {{ affiliate_url | json }},
      "videoUrl": {{ video_url | json }},
      "images": {{ image_urls | json }},
      "rating": {% if rating != blank %}{{ rating | plus: 0 | json }}{% else %}null{% endif %},
      "shareUrl": {{ share_url | json }}
    }
  </script>
</article>


<div class="cart-featured-collection">
  
  {% if settings.cartFeaHeading != blank %}
  <div class="cart-featured-coll-header">
    <h3>{{ settings.cartFeaHeading }}</h3>
  </div>
  {% endif %}
 {% assign collection = settings.cart_featuredColl %}
 
  {% assign new_var = '' %}
  {% for product in collection.products %}
    {% for item in cart.items %}
      {% if item.product.id == product.id %}
        {% assign new_var = new_var | append:  product.id  %}
        {% assign new_var = new_var | append:  ','  %}
      {% else %}
      {% endif %}
     {% endfor %}
   {% endfor %}
  
  <div class="cart-featured-coll-body">
    <div class="cart-featured-coll-flex">
    {%- for product in collection.products -%}
      {% unless new_var contains product.id %}
        <div class="cart-coll-item"> 
          {% render 'cart-featured-item',
            card_product: product,
            media_aspect_ratio: 'portrait',
            image_shape: 'default',
            show_secondary_image: true,
            show_vendor: false,
            show_rating: false,
            show_quick_add: true,
            section_id: section.id,
            section: section
          %}
        </div>
      {% endunless %}
    {% endfor %}
    </div>
  </div>
  
</div>
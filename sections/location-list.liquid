{{ 'location-list.css' | asset_url | stylesheet_tag }}
<div class="location-list">
  <div class="page-width">
    
    {% if section.settings.heading != blank %}
    <div class="location-list-header">
      <h3>{{ section.settings.heading }}</h3>
    </div>
     {% endif %}
    
    <div class="location-list-body">
      <ul class="location-list-row">
        {%- for block in section.blocks -%}
          {% if block.settings.title != blank %}
          <li>
            <a href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}jabascript:void(0);{% endif %}">
              {{ block.settings.title }}
            </a>
          </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
    
  </div>
</div>
{% schema %}
  {
    "name": "Location List",
    "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        }
      ],
     "blocks": [
        {
        "type": "block",
        "name": "block",
          "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name":"Location List"
      }
    ]
  }
{% endschema %}
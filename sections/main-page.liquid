{%- style -%}
  .reel-page-container {
    max-width: 680px;
    margin: 0 auto;
    padding: 32px 20px 80px;
    color: #fff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    min-height: 100vh;
    min-height: 100dvh;
    overflow-y: auto;
  }
  .reel-page-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--rs-text-dim, rgba(255,255,255,0.7));
    font-size: 0.9rem;
    margin-bottom: 20px;
    text-decoration: none;
  }
  .reel-page-title {
    font-size: 1.8rem;
    font-weight: 800;
    margin: 0 0 20px;
  }
  .reel-page-content {
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }
{%- endstyle -%}

<div class="reel-page-container">
  <a href="{{ routes.root_url }}" class="reel-page-back">
    ← Back to Reels
  </a>
  <h1 class="reel-page-title">
    {{ page.title | escape }}
  </h1>
  <div class="reel-page-content">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}

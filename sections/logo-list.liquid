{{ 'logo-list.css' | asset_url | stylesheet_tag }}
<div class="logo-list logo-list-{{ section.id }}">
  <div class="">
    
    {% if section.settings.subHeading != blank or section.settings.heading != blank %}
    <div class="logo-list-header">
      {% if section.settings.subHeading != blank %}
        <span class="sub-heading">{{ section.settings.subHeading }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="heading">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>
    {% endif %}
    
    <div class="logo-list-body">
      <div class="logo-list-flex">
        {% for block in section.blocks %}
          <div class="logo-item">
            <a href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}javascript:void(0){% endif %}">
               <div
                  class="image-with-text__media  global-media-settings {% if block.settings.image != blank %} media{% else %} image-with-text__media--placeholder placeholder{% endif %}"
                  {% if block.settings.image != blank %}
                    style="padding-bottom: {{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;"
                  {% endif %}
                >
                  {%- if block.settings.image != blank -%}
                      {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
                      {%- capture sizes -%}
                        (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                        (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
                      {%- endcapture -%}
                    {{
                      block.settings.image
                      | image_url: width: 1500
                      | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
                    }}
                  {%- else -%}
                    {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
               </div>
            </a>
          </div>
        {% endfor %}
      </div>
    </div>
    
  </div>
</div>


<style>
.logo-list-{{ section.id }}{
  padding-top:{{section.settings.paddingTopMobile}}px;
  padding-bottom:{{section.settings.paddingBottomMobile}}px;
}
.logo-list-{{ section.id }} .logo-list-header .heading{
  font-size: {{section.settings.headingSizeMobile}}px;
  line-height: 1.3;
  color:{{section.settings.headingColor}};
  text-align:{{section.settings.headingAligment}};
}  
.logo-list-{{ section.id }} .logo-list-header .sub-heading{
  font-size: {{section.settings.subHeadingSizeMobile}}px;
  color:{{section.settings.subHeadingColor}};
  text-align:{{section.settings.subHeadingAligment}};
} 
.logo-list-{{ section.id }} .logo-list-flex .logo-item{
  width:{{section.settings.blockWidthMobile}}px;
  min-width:{{section.settings.blockWidthMobile}}px;
}   
@media(min-width:749px){
  .logo-list-{{ section.id }}{
    padding-top:{{section.settings.paddingTopDesktop}}px;
    padding-bottom:{{section.settings.paddingBottomDesktop}}px;
  }
  .logo-list-{{ section.id }} .logo-list-header .heading{
    font-size: {{section.settings.headingSizeDesktop}}px;
  }  
  .logo-list-{{ section.id }} .logo-list-header .sub-heading{
    font-size: {{section.settings.subHeadingSizeDesktop}}px;
  } 
  .logo-list-{{ section.id }} .logo-list-flex .logo-item{
    width:{{section.settings.blockWidthDesktop}}px;
    min-width:{{section.settings.blockWidthDesktop}}px;
  } 
}
  
</style>

{% schema %}
  {
    "name": "Logo List",
    "settings": [
        {
          "type": "header",
          "content": "Sub Heading"
        },
        {
          "type": "textarea",
          "id": "subHeading",
          "label": "Sub Heading"
        },
        {
          "type": "color",
          "id": "subHeadingColor",
          "label": "Sub Heading Color",
          "default": "#000"
        },
        {
          "type": "select",
          "id": "subHeadingAligment",
          "options": [
            {
              "value": "left",
              "label": "left"
            },
            {
              "value": "center",
              "label": "center"
            },
            {
              "value": "right",
              "label": "right"
            }
          ],
          "default": "center",
          "label": "Sub Heading Alignment"
        },
        {
          "type": "range",
          "id": "subHeadingSizeDesktop",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 15,
          "unit": "px",
          "label": "Sub Heading Font Size (Desktop)"
        },
        {
          "type": "range",
          "id": "subHeadingSizeMobile",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 14,
          "unit": "px",
          "label": "Sub Heading Font Size (Mobile)"
        },
        {
          "type": "header",
          "content": "Heading"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "color",
          "id": "headingColor",
          "label": "Heading Color",
          "default": "#000"
        },
        {
          "type": "select",
          "id": "headingAligment",
          "options": [
            {
              "value": "left",
              "label": "left"
            },
            {
              "value": "center",
              "label": "center"
            },
            {
              "value": "right",
              "label": "right"
            }
          ],
          "default": "center",
          "label": "Heading Alignment"
        },
        {
          "type": "range",
          "id": "headingSizeDesktop",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 15,
          "unit": "px",
          "label": "Heading Font Size (Desktop)"
        },
        {
          "type": "range",
          "id": "headingSizeMobile",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 14,
          "unit": "px",
          "label": "Heading Font Size (Mobile)"
        },
        {
          "type": "header",
          "content": "block Item"
        },
        {
          "type": "range",
          "id": "blockWidthDesktop",
          "min": 0,
          "max": 1000,
          "step": 10,
          "unit": "PX",
          "label": "Block Width(Desktop)",
          "default": 260
        },
        {
          "type": "range",
          "id": "blockWidthMobile",
          "min": 0,
          "max": 500,
          "step": 5,
          "unit": "PX",
          "label": "Block Width(Mobile)",
          "default": 90
        },
        {
          "type": "header",
          "content": "Padding"
        },
        {
          "type": "range",
          "id": "paddingTopDesktop",
          "min": 1,
          "max": 100,
          "step": 1,
          "unit": "PX",
          "label": "Padding Top (Desktop)",
          "default": 40
        },
        {
          "type": "range",
          "id": "paddingBottomDesktop",
          "min": 1,
          "max": 100,
          "step": 1,
          "unit": "PX",
          "label": "Padding Bottom (Desktop)",
          "default": 40
        },
        {
          "type": "range",
          "id": "paddingTopMobile",
          "min": 1,
          "max": 100,
          "step": 1,
          "unit": "PX",
          "label": "Padding Top (Mobile)",
          "default": 20
        },
        {
          "type": "range",
          "id": "paddingBottomMobile",
          "min": 1,
          "max": 100,
          "step": 1,
          "unit": "PX",
          "label": "Padding Bottom (Mobile)",
          "default": 20
        }
      ],
     "blocks": [
        {
        "type": "block",
        "name": "block",
          "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name":"Logo List"
      }
    ]
  }
{% endschema %}
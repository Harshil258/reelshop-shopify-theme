<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
    <meta name="theme-color" content="#000000">
    <link rel="canonical" href="{{ canonical_url }}">

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.shopify.com">
    <link rel="dns-prefetch" href="https://images.unsplash.com">
    <link rel="dns-prefetch" href="https://vjs.zencdn.net">

    <link rel="preload" href="{{ 'reelshop.css' | asset_url }}" as="style">

    {%- assign first_item = collections.all.products.first -%}
    {%- if first_item.featured_image != blank -%}
      <link rel="preload" as="image" href="{{ first_item.featured_image | image_url: width: 800 }}" fetchpriority="high">
    {%- endif -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {% style %}
      :root {
        --rs-font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        height: 100dvh;
        height: -webkit-fill-available;
        overflow: hidden;
        background-color: #000000;
        color: #ffffff;
        font-family: var(--rs-font-family);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overscroll-behavior: none;
        touch-action: pan-y;
        position: fixed;
        inset: 0;
      }

      #MainContent {
        width: 100%;
        height: 100%;
        height: 100dvh;
        height: -webkit-fill-available;
        overflow: hidden;
        position: relative;
      }

      /* Hide any residual Dawn header/footer elements */
      .shopify-section-group-header-group,
      .shopify-section-group-footer-group,
      .header-wrapper,
      .announcement-bar,
      footer.footer,
      #shopify-section-cart-drawer {
        display: none !important;
      }
    {% endstyle %}

    {{ 'reelshop.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
      window.shopUrl = '{{ request.origin }}';
    </script>
  </head>

  <body>
    <main id="MainContent" class="focus-none" role="main" tabindex="-1">
      {%- if template.name == 'page' -%}
        {{ content_for_layout }}
      {%- else -%}
        {% section 'reels-feed' %}
        <div style="display:none !important;" hidden>{{ content_for_layout }}</div>
      {%- endif -%}
    </main>
  </body>
</html>
